    <string name="compat_title">Compatibility</string>
    <string name="compat_status_supported">Supported</string>
    <string name="compat_status_limited">Limited</string>
    <string name="compat_status_protected">Protected / Restricted</string>
    <string name="compat_status_unknown">Unknown / Needs Testing</string>
    <string name="compat_status_container_verified">Container: Launch Verified</string>
    <string name="compat_desc_supported">Standard Android application with no known anti-virtualization flags or strict hardware keystore lockouts.</string>
    <string name="compat_desc_limited">Application uses features such as Google Play Services dependencies, push notifications, or custom content providers that may have partial isolation limitations.</string>
    <string name="compat_desc_protected">Application exposes system or shared-UID restrictions in package metadata; runtime attestation and vendor-specific behavior still require live testing.</string>
    <string name="compat_desc_unknown">Unanalyzed package structure. Compatibility will be verified during isolation testing.</string>
    <string name="compat_desc_container_verified">Application code executed successfully inside isolated container sandbox.</string>

