    <string name="settings_architecture_title">Engine &amp; Technology</string>
    <string name="settings_view_engine_spec">Cloning Engine Specifications</string>
    <string name="settings_view_engine_spec_desc">Read details on Mirro\'s user-space container runtime</string>
    <string name="arch_title">Engineering Architecture</string>
    <string name="arch_subtitle">Platform constraints and technical strategy</string>
    <string name="arch_overview_title">Core Architectural Strategy</string>
    <string name="arch_overview_desc">Mirro decouples UI presentation from the cloning execution engine. Rather than using brittle hacks, Mirro embraces Android platform primitives with high technical fidelity.</string>
    <string name="arch_strategy_container_title">User-space Container Runtime</string>
    <string name="arch_strategy_container_desc">Mirro partitions clone storage, indexes target DEX classes, creates a virtual context, and bootstraps the target Application inside a dedicated container process slot.</string>
    <string name="arch_constraints_title">Android Platform Security &amp; Limits</string>
    <string name="arch_constraints_desc">Starting in Android 11+, Package Visibility rules require specific queries declarations. Furthermore, Play Integrity attestation and hardware keystores cannot and should not be subverted.</string>
    <string name="arch_chatgpt_case_title">Primary Acceptance Test: ChatGPT</string>
    <string name="arch_chatgpt_case_desc">Evaluates com.openai.chatgpt as the primary acceptance-test app. Compatibility is marked as Unknown pending real runtime isolation verification.</string>

