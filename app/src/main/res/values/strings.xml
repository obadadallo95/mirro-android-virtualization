    <string name="settings_brand_identity_title">Brand Identity &amp; Design System</string>
    <string name="settings_brand_identity_desc">Explore the Mirro logo concept, optical grid, colors, and typography</string>
    <string name="brand_title">Mirro Brand Identity</string>
    <string name="brand_subtitle">Brand Guidelines &amp; Design System</string>
    <string name="brand_concept_title">1. Symbol Concept &amp; Anatomy</string>
    <string name="brand_concept_subtitle">The Reflected M — Mirroring without Entanglement</string>
    <string name="brand_concept_desc">The Mirro symbol synthesizes three ideas into a single glyph: a mirror\'s reflection line, the letter M, and two autonomous app spaces.</string>
    <string name="brand_anatomy_01_title">The Optical Mirror Meridian</string>
    <string name="brand_anatomy_01_desc">A central vertical axis of symmetry that acts as the mirror plane, creating an optical corridor down the center.</string>
    <string name="brand_anatomy_02_title">The Letter M Geometry</string>
    <string name="brand_anatomy_02_desc">Twin outer vertical pillars, dual rounded apexes, and inward diagonal facets naturally trace the letter M.</string>
    <string name="brand_anatomy_03_title">Duplication with Separation</string>
    <string name="brand_anatomy_03_desc">The left wing represents the Primary Host Instance (Cobalt #1E40AF). The right wing represents the Reflected Instance (Cyan #38BDF8).</string>
    <string name="brand_anatomy_04_title">Non-Entanglement Micro-Gap</string>
    <string name="brand_anatomy_04_desc">The two halves never touch across the mirror axis, communicating zero data entanglement between instances.</string>
    <string name="brand_palette_title">3. Color Palette &amp; Functional Roles</string>
    <string name="brand_palette_desc">The Reflective Spectrum — Restrained, Confident, Android-First</string>
    <string name="brand_typography_title">4. Typography System</string>
    <string name="brand_typography_desc">Clean modern neo-grotesque sans-serif pairings</string>
    <string name="brand_splash_title">5. Splash Screen Concept</string>
    <string name="brand_splash_desc">Android 12+ launch screen specification</string>
    <string name="brand_splash_tap_preview">Tap to Preview Full Launch Screen</string>
    <string name="brand_principles_title">6. Brand Principles &amp; Voice</string>

